APP_NAME="Bozzname server"
APP_KEY="your app key"
PORT=3000
NODE_ENV=development
# Public backend URL (required for DynoPay webhook_url – must be reachable by DynoPay).
# For local testing with DynoPay webhooks, use your ngrok URL (no trailing slash):
# APP_URL=https://mannerless-braylen-unmercifully.ngrok-free.dev
APP_URL=http://localhost:$PORT
FRONTEND_URL=http://localhost:5173

DB_URI=mongodb://localhost:27017/bozzname-api

CONNECTSELLER_API_KEY="randomkey"

JWT_KEY="randomkey"

GOOGLE_CLIENT_ID="google client id"
GOOGLE_CLIENT_SECRET="google client secret"
GOOGLE_REDIRECT_URL=$backend_url/auth/google/callback
GOOGLE_LINK_REDIRECT_URL=$backend_url/auth/google/link/callback
GOOGLE_PROJECT_ID=nameword-123456

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=username@smtp-brevo.com
MAIL_PASSWORD=password
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@gmail.com

MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN="bot token"
ADMIN_REGISTER_TOKEN="randomkey"

WHM_USERNAME=root
WHM_API_KEY="XXXXXXXXXXXX"
WHM_SERVER_URL=https://example.com:2087
WHM_DEFAULT_PASSWORD="Password@123*456"

# DynoPay: JWT (Admin Token) is required; API key is optional (not required per DynoPay)
# DYNO_PAY_API_KEY="..."
DYNO_PAY_BASE_URL="https://dynobackendconsolidated.up.railway.app"
DYNO_PAY_JWT_TOKEN="your-dynopay-admin-jwt-token"
DYNO_PAY_COMPANY_ID="39"
# Optional: webhook secret for verifying X-DynoPay-Signature (leave empty to skip verification)
# DYNO_PAY_WEBHOOK_SECRET="your-webhook-secret-from-dynopay-dashboard"
# Optional: use a different base URL for user registration (createUser) if it lives on another host than the payment-link API
# DYNO_PAY_USER_API_URL="https://your-user-api-host.com"
DYNO_PAY_WALLET_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXXXXXX"

ADMIN_MAIL_ADDRESS=admin@gmail.com

UPCLOUD_USERNAME=test
UPCLOUD_PASSWORD=test@123

FAST_FOREX_KEY=1234567890

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""

GCLOUD_STORAGE_BUCKET_NAME=""

HOSTBAY_API_KEY=""

BREVO_API_KEY=
BREVO_EMAIL=
MAIL_NAME=
CORS_ORIGIN=